{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "application": {
      "type": "object"
    },
    "as_of_utc": {
      "format": "date-time",
      "type": "string"
    },
    "attribution": {
      "type": "object"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "current_state": {
      "additionalProperties": false,
      "properties": {
        "maturity_state": {
          "enum": [
            "NOT_APPLIED",
            "COLLECTING",
            "PROVISIONAL",
            "REPRESENTATIVE",
            "MATURE"
          ]
        },
        "realization_state": {
          "enum": [
            "NOT_APPLIED",
            "APPLIED",
            "VALIDATING",
            "REALIZED",
            "UNDER_REALIZED",
            "VALIDATION_FAILED",
            "MONITORING",
            "ROLLED_BACK",
            "DRIFTED",
            "INVALIDATED",
            "REGENERATING",
            "BLOCKED",
            "SAFETY_ACTION_APPLIED",
            "PERFORMANCE_VALIDATED",
            "CAPACITY_VALIDATED"
          ]
        },
        "source_package_disposition": {
          "enum": [
            "ACTIVE",
            "SUPERSEDED",
            "EXPIRED",
            "BLOCKED"
          ]
        },
        "validation_state": {
          "enum": [
            "NOT_READY",
            "READY",
            "RUNNING",
            "PASSED",
            "FAILED",
            "INCONCLUSIVE"
          ]
        }
      },
      "required": [
        "realization_state",
        "validation_state",
        "maturity_state",
        "source_package_disposition"
      ],
      "type": "object"
    },
    "drift": {
      "type": "object"
    },
    "economics": {
      "type": "object"
    },
    "history": {
      "type": "object"
    },
    "maturity": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    },
    "realization_package_id": {
      "pattern": "^RPKG-[0-9A-F]{24}$",
      "type": "string"
    },
    "regeneration": {
      "type": "object"
    },
    "snapshot_id": {
      "pattern": "^RSNAP-[0-9A-F]{24}$",
      "type": "string"
    },
    "source_recommendation": {
      "properties": {
        "cost_profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_change": {
          "type": [
            "object",
            "null"
          ]
        },
        "recommendation_package_id": {
          "pattern": "^PKG-[0-9A-F]+$",
          "type": "string"
        },
        "run_scope": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "recommendation_package_id",
        "run_scope",
        "cost_profile",
        "observed_change"
      ],
      "type": "object"
    },
    "validation": {
      "type": "object"
    },
    "warehouse": {
      "type": "object"
    }
  },
  "required": [
    "contract_version",
    "realization_package_id",
    "snapshot_id",
    "source_recommendation",
    "warehouse",
    "as_of_utc",
    "current_state",
    "application",
    "validation",
    "economics",
    "attribution",
    "maturity",
    "drift",
    "regeneration",
    "history",
    "provenance"
  ],
  "title": "RealizationPackage",
  "type": "object"
}
