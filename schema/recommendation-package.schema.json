{
  "$defs": {
    "AppliedChange": {
      "additionalProperties": false,
      "properties": {
        "applied_at": {
          "format": "date-time",
          "type": "string"
        },
        "applied_by": {
          "minLength": 1,
          "type": "string"
        },
        "applied_config": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": "object"
        },
        "previous_config": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": "object"
        }
      },
      "required": [
        "applied_at",
        "applied_by",
        "previous_config",
        "applied_config"
      ],
      "type": "object"
    },
    "Assessment": {
      "additionalProperties": false,
      "properties": {
        "evidence_quality": {
          "$ref": "#/$defs/EvidenceQuality"
        },
        "overall_status": {
          "enum": [
            "OPTIMIZATION_AVAILABLE",
            "NO_CHANGE",
            "REVIEW_REQUIRED",
            "BLOCKED",
            "INSUFFICIENT_EVIDENCE"
          ],
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/AssessmentSummary"
        }
      },
      "required": [
        "overall_status",
        "summary",
        "evidence_quality"
      ],
      "type": "object"
    },
    "AssessmentSummary": {
      "additionalProperties": false,
      "properties": {
        "actionable_count": {
          "minimum": 0,
          "type": "integer"
        },
        "blocked_count": {
          "minimum": 0,
          "type": "integer"
        },
        "candidate_count": {
          "minimum": 0,
          "type": "integer"
        },
        "insufficient_evidence_count": {
          "minimum": 0,
          "type": "integer"
        },
        "no_change_count": {
          "minimum": 0,
          "type": "integer"
        },
        "not_applicable_count": {
          "minimum": 0,
          "type": "integer"
        },
        "review_count": {
          "minimum": 0,
          "type": "integer"
        },
        "test_required_count": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "candidate_count",
        "actionable_count",
        "test_required_count",
        "review_count",
        "blocked_count",
        "no_change_count",
        "not_applicable_count",
        "insufficient_evidence_count"
      ],
      "type": "object"
    },
    "CandidateRecommendation": {
      "additionalProperties": false,
      "properties": {
        "blockers": {
          "items": {
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "candidate_id": {
          "pattern": "^CAND-[A-F0-9]{24}$",
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "current_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/DependencyRef"
          },
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "pattern": "^EVID-[A-F0-9]{24}$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "independent_economics": {
          "$ref": "#/$defs/IndependentEconomics"
        },
        "invalidates": {
          "items": {
            "enum": [
              "warehouse_type",
              "warehouse_size",
              "min_clusters",
              "max_clusters",
              "auto_stop_minutes",
              "warehouse_channel",
              "enable_photon"
            ],
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "knob": {
          "enum": [
            "warehouse_type",
            "warehouse_size",
            "min_clusters",
            "max_clusters",
            "auto_stop_minutes",
            "warehouse_channel",
            "enable_photon"
          ],
          "type": "string"
        },
        "objectives": {
          "items": {
            "enum": [
              "COST",
              "PERFORMANCE",
              "COST_AND_PERFORMANCE",
              "COST_GUARDRAIL",
              "STABILITY",
              "RELIABILITY",
              "OPERATIONS",
              "MIGRATION"
            ],
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "rationale": {
          "minLength": 1,
          "type": "string"
        },
        "recommended_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "ACTIONABLE",
            "TEST_REQUIRED",
            "REVIEW",
            "BLOCKED",
            "NO_CHANGE",
            "NOT_APPLICABLE",
            "INSUFFICIENT_EVIDENCE"
          ],
          "type": "string"
        },
        "technique_id": {
          "pattern": "^WH-[A-Z0-9-]+-[0-9]{3}$",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "technique_id",
        "knob",
        "status",
        "current_value",
        "recommended_value",
        "objectives",
        "rationale",
        "evidence_refs",
        "blockers",
        "dependencies",
        "invalidates",
        "confidence",
        "independent_economics"
      ],
      "type": "object"
    },
    "ClientApplicationStat": {
      "additionalProperties": false,
      "properties": {
        "query_count": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "query_count"
      ],
      "type": "object"
    },
    "Compatibility": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/CompatibilityCheck"
          },
          "type": "array"
        },
        "mode": {
          "enum": [
            "B_READ_ONLY_API",
            "A_HITL_FALLBACK",
            "B_READ_ONLY_API_WITH_A_FALLBACK",
            "SYSTEM_TABLE_ONLY"
          ],
          "type": "string"
        },
        "status": {
          "enum": [
            "COMPATIBLE",
            "REQUIRES_VALIDATION",
            "INCOMPATIBLE",
            "UNKNOWN"
          ],
          "type": "string"
        }
      },
      "required": [
        "status",
        "mode",
        "checks"
      ],
      "type": "object"
    },
    "CompatibilityCheck": {
      "additionalProperties": false,
      "properties": {
        "check": {
          "minLength": 1,
          "type": "string"
        },
        "details": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_refs": {
          "items": {
            "pattern": "^EVID-[A-F0-9]{24}$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "requires_hitl": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ],
          "type": "string"
        }
      },
      "required": [
        "check",
        "status",
        "requires_hitl",
        "evidence_refs",
        "details"
      ],
      "type": "object"
    },
    "ComponentRanges": {
      "additionalProperties": false,
      "properties": {
        "aws": {
          "anyOf": [
            {
              "$ref": "#/$defs/Range3"
            },
            {
              "type": "null"
            }
          ]
        },
        "dbu": {
          "anyOf": [
            {
              "$ref": "#/$defs/Range3"
            },
            {
              "type": "null"
            }
          ]
        },
        "total": {
          "anyOf": [
            {
              "$ref": "#/$defs/Range3"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "dbu",
        "aws",
        "total"
      ],
      "type": "object"
    },
    "Confidence": {
      "additionalProperties": false,
      "properties": {
        "components": {
          "additionalProperties": {
            "anyOf": [
              {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": "object"
        },
        "level": {
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW",
            "UNKNOWN"
          ],
          "type": "string"
        },
        "method": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "score",
        "level",
        "components",
        "method"
      ],
      "type": "object"
    },
    "CostBaseline": {
      "additionalProperties": false,
      "properties": {
        "actual_365d": {
          "$ref": "#/$defs/CostBreakdown"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        "forecast": {
          "$ref": "#/$defs/ForecastInfo"
        },
        "forward_365d": {
          "$ref": "#/$defs/CostBreakdown"
        }
      },
      "required": [
        "currency",
        "actual_365d",
        "forward_365d",
        "forecast"
      ],
      "type": "object"
    },
    "CostBreakdown": {
      "additionalProperties": false,
      "properties": {
        "availability": {
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "UNAVAILABLE"
          ],
          "type": "string"
        },
        "aws_basis": {
          "enum": [
            "OBSERVED_DATABRICKS_BILLING",
            "OBSERVED_AWS_BILLING",
            "MODELED_AWS_LIST_PRICE",
            "MODELED_CURRENT_EPOCH",
            "FORECAST",
            "COUNTERFACTUAL",
            "UNAVAILABLE"
          ],
          "type": "string"
        },
        "aws_cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "dbu_basis": {
          "enum": [
            "OBSERVED_DATABRICKS_BILLING",
            "OBSERVED_AWS_BILLING",
            "MODELED_AWS_LIST_PRICE",
            "MODELED_CURRENT_EPOCH",
            "FORECAST",
            "COUNTERFACTUAL",
            "UNAVAILABLE"
          ],
          "type": "string"
        },
        "dbu_cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "total_cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "dbu_cost",
        "aws_cost",
        "total_cost",
        "availability",
        "dbu_basis",
        "aws_basis"
      ],
      "type": "object"
    },
    "CurrentConfig": {
      "additionalProperties": false,
      "properties": {
        "auto_stop_minutes": {
          "minimum": 0,
          "type": "integer"
        },
        "max_clusters": {
          "maximum": 40,
          "minimum": 1,
          "type": "integer"
        },
        "min_clusters": {
          "maximum": 40,
          "minimum": 1,
          "type": "integer"
        },
        "photon": {
          "$ref": "#/$defs/PhotonConfigObservation"
        },
        "warehouse_channel": {
          "minLength": 1,
          "type": "string"
        },
        "warehouse_size": {
          "minLength": 1,
          "type": "string"
        },
        "warehouse_type": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "warehouse_type",
        "warehouse_size",
        "min_clusters",
        "max_clusters",
        "auto_stop_minutes",
        "warehouse_channel",
        "photon"
      ],
      "type": "object"
    },
    "CurrentEpoch": {
      "additionalProperties": false,
      "properties": {
        "age_days": {
          "minimum": 0,
          "type": "integer"
        },
        "epoch_id": {
          "pattern": "^EPOCH-[A-F0-9]{24}$",
          "type": "string"
        },
        "is_current": {
          "const": true
        },
        "start_time": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "epoch_id",
        "start_time",
        "age_days",
        "is_current"
      ],
      "type": "object"
    },
    "DependencyRef": {
      "additionalProperties": false,
      "properties": {
        "condition": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "dependency_type": {
          "enum": [
            "CANDIDATE",
            "TECHNIQUE",
            "KNOB",
            "COMPATIBILITY_CHECK",
            "EVIDENCE"
          ],
          "type": "string"
        },
        "ref_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "dependency_type",
        "ref_id",
        "condition"
      ],
      "type": "object"
    },
    "EconomicsPoint": {
      "additionalProperties": false,
      "properties": {
        "aws": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "dbu": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "total": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "dbu",
        "aws",
        "total"
      ],
      "type": "object"
    },
    "EvidenceQuality": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "cost_history_sufficient": {
          "type": "boolean"
        },
        "epoch_mature": {
          "type": "boolean"
        },
        "query_sample_sufficient": {
          "type": "boolean"
        },
        "source_coverage_pct": {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        "status": {
          "enum": [
            "SUFFICIENT",
            "PARTIAL",
            "INSUFFICIENT"
          ],
          "type": "string"
        }
      },
      "required": [
        "status",
        "confidence",
        "query_sample_sufficient",
        "cost_history_sufficient",
        "epoch_mature",
        "source_coverage_pct"
      ],
      "type": "object"
    },
    "EvidenceRecord": {
      "additionalProperties": false,
      "properties": {
        "comparator": {
          "type": "string"
        },
        "epoch_scope": {
          "minLength": 1,
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^EVID-[A-F0-9]{24}$",
          "type": "string"
        },
        "interpretation": {
          "minLength": 1,
          "type": "string"
        },
        "metric": {
          "minLength": 1,
          "type": "string"
        },
        "observation_window": {
          "minLength": 1,
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "type": "string"
        },
        "source_field": {
          "minLength": 1,
          "type": "string"
        },
        "threshold": {},
        "unit": {
          "minLength": 1,
          "type": "string"
        },
        "value": {}
      },
      "required": [
        "evidence_id",
        "metric",
        "value",
        "unit",
        "source",
        "source_field",
        "epoch_scope",
        "observation_window",
        "threshold",
        "comparator",
        "interpretation"
      ],
      "type": "object"
    },
    "ExcludedScenario": {
      "additionalProperties": false,
      "properties": {
        "reason_code": {
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "type": "string"
        },
        "scenario_id": {
          "pattern": "^SCN-[A-F0-9]{24}$",
          "type": "string"
        }
      },
      "required": [
        "scenario_id",
        "reason_code"
      ],
      "type": "object"
    },
    "ForecastInfo": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "model": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "model",
        "confidence",
        "assumptions"
      ],
      "type": "object"
    },
    "IndependentEconomics": {
      "additionalProperties": false,
      "properties": {
        "baseline_365d": {
          "$ref": "#/$defs/CostBreakdown"
        },
        "estimated_cost_365d": {
          "$ref": "#/$defs/ComponentRanges"
        },
        "estimation_status": {
          "enum": [
            "MODELED_RANGE",
            "PROVISIONAL_MODELED_RANGE",
            "PRE_CANARY_MODELED_RANGE",
            "MEASURED",
            "NO_DELTA_MODELED",
            "UNAVAILABLE"
          ],
          "type": "string"
        },
        "is_additive": {
          "const": false
        },
        "savings_365d": {
          "$ref": "#/$defs/ComponentRanges"
        }
      },
      "required": [
        "is_additive",
        "estimation_status",
        "baseline_365d",
        "estimated_cost_365d",
        "savings_365d"
      ],
      "type": "object"
    },
    "PackageEconomics": {
      "additionalProperties": false,
      "properties": {
        "baseline_365d": {
          "$ref": "#/$defs/CostBreakdown"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        "estimated_cost_365d": {
          "anyOf": [
            {
              "$ref": "#/$defs/Range3"
            },
            {
              "type": "null"
            }
          ]
        },
        "estimated_savings_365d": {
          "anyOf": [
            {
              "$ref": "#/$defs/Range3"
            },
            {
              "type": "null"
            }
          ]
        },
        "excluded_scenarios": {
          "items": {
            "$ref": "#/$defs/ExcludedScenario"
          },
          "type": "array"
        },
        "included_scenario_ids": {
          "items": {
            "pattern": "^SCN-[A-F0-9]{24}$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "scenario_envelope": {
          "$ref": "#/$defs/ScenarioEnvelope"
        },
        "semantics": {
          "$ref": "#/$defs/PackageEconomicsSemantics"
        }
      },
      "required": [
        "currency",
        "baseline_365d",
        "estimated_savings_365d",
        "estimated_cost_365d",
        "scenario_envelope",
        "included_scenario_ids",
        "excluded_scenarios",
        "semantics"
      ],
      "type": "object"
    },
    "PackageEconomicsSemantics": {
      "additionalProperties": false,
      "properties": {
        "is_additive": {
          "const": false
        },
        "is_probability_interval": {
          "const": false
        },
        "method": {
          "const": "SCENARIO_ENVELOPE"
        }
      },
      "required": [
        "method",
        "is_additive",
        "is_probability_interval"
      ],
      "type": "object"
    },
    "PhotonConfigObservation": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "enabled_usage_pct": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_source": {
          "minLength": 1,
          "type": "string"
        },
        "freshness_days": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "known_feature_coverage_pct": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "ENABLED",
            "DISABLED",
            "MIXED",
            "UNKNOWN"
          ],
          "type": "string"
        }
      },
      "required": [
        "status",
        "evidence_source",
        "confidence",
        "enabled_usage_pct",
        "known_feature_coverage_pct",
        "freshness_days"
      ],
      "type": "object"
    },
    "PlanStep": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidate_id": {
          "anyOf": [
            {
              "pattern": "^CAND-[A-F0-9]{24}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "current_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
