# Non-secret runtime selectors only. Do not put PATs/tokens here.
# Nothing loads this file: copy it to .env and `set -a; source .env; set +a` before running the Publisher.
# The Realizer reads no environment variables; pass --profile, --sql-warehouse-id and --source-region to it.
DATABRICKS_CONFIG_PROFILE=WHOPT
# Choose one execution target:
# DATABRICKS_SERVERLESS_WAREHOUSE_ID=<serverless-warehouse-id>
# DATABRICKS_SQL_WAREHOUSE_ID=<any-sql-warehouse-id>
# DATABRICKS_ALL_PURPOSE_CLUSTER_ID=<all-purpose-cluster-id>
# DATABRICKS_WORKSPACE_ID=<workspace-org-id-if-needed-for-cluster>
DATABRICKS_REGION=us-east-1
# Optional if your Databricks CLI config is not ~/.databrickscfg
# DATABRICKS_CONFIG_FILE=/path/to/.databrickscfg
# Optional custom versioned AWS EC2 price registry. Default: pricing/aws_ec2_on_demand.json
# AWS_PRICE_REGISTRY=/path/to/aws_ec2_on_demand.json
# Optional processing batch size after regional system-table extraction
WAREHOUSE_BATCH_SIZE=100

# B read-only compatibility evidence when available, else A fallback
COMPATIBILITY_API_MODE=auto
PUBLISHER_LOG_LEVEL=INFO
# Where the run executes (only local today)
# PUBLISHER_EXECUTION_MODE=local

# Live integration tests (tests/integration), skipped unless set
# PUBLISHER_LIVE_PROFILE=WHOPT
# PUBLISHER_LIVE_SQL_WAREHOUSE_ID=<collector-warehouse-id>
# PUBLISHER_LIVE_SERVERLESS_WAREHOUSE_ID=<serverless-warehouse-id>
# PUBLISHER_LIVE_SOURCE_REGION=us-east-1
